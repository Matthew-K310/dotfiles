(defcfg
  input  (device-file "/dev/input/by-id/usb-Keychron_K4_Keychron_K4-event-kbd")
  output (uinput-sink "KMonad output")
  fallthrough true
  allow-cmd false
)

(defsrc
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(deflayer base
  esc  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps @a   @s   @d   @f   g    h    @j   @k   @l   @;   '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defalias
  caps (tap-hold 200 esc lctl)
  
  ;; Define the hold actions first
  a (tap-hold-next-release 200 a lmet)
  s (tap-hold-next-release 200 s lalt)
  d (tap-hold-next-release 200 d lsft)
  f (tap-hold-next-release 200 f lctl)
  
  j (tap-hold-next-release 200 j rctl)
  k (tap-hold-next-release 200 k rsft)
  l (tap-hold-next-release 200 l ralt)
  ; (tap-hold-next-release 200 ; rmet)
)
